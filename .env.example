# Fonte de dados: "csv" (padrão, lê data/*.csv) ou "sql" (Azure SQL Database)
DATA_SOURCE=csv

# Necessário apenas quando DATA_SOURCE=sql
AZURE_SQL_SERVER=sql-xxxxx.database.windows.net
AZURE_SQL_DATABASE=finopsdb
AZURE_SQL_USER=finopsadmin
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433

# Identidade do provedor usada no template do Azure Lighthouse (pagina Connect Azure).
# Placeholders quando vazio; preencha com o tenant e o service principal reais.
FINOPS_PROVIDER_TENANT_ID=
FINOPS_PROVIDER_PRINCIPAL_ID=
FINOPS_PROVIDER_PRINCIPAL_NAME=FinOps Insight Engine

# Plano ativo na emulacao quando data/state/plan.json nao existe: assessment, starter, pro, enterprise, partner
FINOPS_PLAN=enterprise
