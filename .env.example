# Data source: "csv" (default, reads data/*.csv) or "sql" (Azure SQL Database)
DATA_SOURCE=csv

# Required only when DATA_SOURCE=sql
AZURE_SQL_SERVER=sql-xxxxx.database.windows.net
AZURE_SQL_DATABASE=finopsdb
AZURE_SQL_USER=finopsadmin
AZURE_SQL_PASSWORD=
AZURE_SQL_PORT=1433
# Schema of the cost anomaly tables when DATA_SOURCE=sql (anomaly_history, weekly_report_coverage, weekly_report_stats, subscription_contacts)
ANOMALY_SQL_SCHEMA=dbo

# Provider identity used in the Azure Lighthouse template (Connect Azure page).
# Placeholders when empty; fill in the real tenant and service principal.
FINOPS_PROVIDER_TENANT_ID=
FINOPS_PROVIDER_PRINCIPAL_ID=
FINOPS_PROVIDER_PRINCIPAL_NAME=FinOps Insight Engine

# Active plan of the emulation when data/state/plan.json does not exist: assessment, starter, pro, enterprise, partner
FINOPS_PLAN=enterprise
